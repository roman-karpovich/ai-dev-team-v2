#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "$0")/.." && pwd)"
marketplace="ai-dev-team-v2-local"
plugin="ai-dev-team"
plugin_dir="ai-dev-team-v2"
legacy_marketplace="ai-dev-team"
legacy_plugin="$plugin@$legacy_marketplace"
target="--all"
replace_v1=false

for argument in "$@"; do
  case "$argument" in
    --all|--codex|--claude)
      target="$argument"
      ;;
    --replace-v1)
      replace_v1=true
      ;;
    *)
      echo "usage: scripts/install-mvp [--all|--codex|--claude] [--replace-v1]" >&2
      exit 2
      ;;
  esac
done

install_cli() {
  local source="$repo_root/plugins/$plugin_dir/bin/adt"
  local destination="$HOME/.local/bin/adt"

  if [[ ! -x "$source" ]]; then
    echo "missing executable: $source" >&2
    return 1
  fi
  mkdir -p "$(dirname "$destination")"

  if [[ -e "$destination" || -L "$destination" ]]; then
    if [[ ! -L "$destination" || "$(readlink "$destination")" != "$source" ]]; then
      echo "refusing to replace existing path: $destination" >&2
      echo "move or remove it explicitly, then rerun the installer" >&2
      return 1
    fi
  fi

  ln -sfn "$source" "$destination"
}

has_codex_marketplace() {
  has_codex_marketplace_name "$marketplace"
}

has_codex_marketplace_name() {
  local name="$1"
  codex plugin marketplace list \
    | awk 'NR > 1 { print $1 }' \
    | grep -Fxq "$name"
}

codex_marketplace_metadata() {
  local name="${1:-$marketplace}"
  codex plugin marketplace list --json \
    | python3 -c '
import json
import sys

name = sys.argv[1]
items = json.load(sys.stdin).get("marketplaces", [])
for item in items:
    if item.get("name") == name:
        source_type = item.get("marketplaceSource", {}).get("sourceType", "")
        root = item.get("root", "")
        print(source_type + "\t" + root)
        raise SystemExit(0)
raise SystemExit(1)
' "$name"
}

refresh_codex_marketplace() {
  local source_type
  local configured_root
  local configured_realpath
  local repo_realpath
  IFS=$'\t' read -r source_type configured_root < <(codex_marketplace_metadata)

  if [[ "$source_type" == "git" ]]; then
    codex plugin marketplace upgrade "$marketplace"
    return 0
  fi

  if [[ "$source_type" != "local" ]]; then
    echo "Codex marketplace $marketplace has unsupported source type: $source_type" >&2
    return 1
  fi

  configured_realpath="$(cd "$configured_root" 2>/dev/null && pwd -P || true)"
  repo_realpath="$(cd "$repo_root" && pwd -P)"

  if [[ "$configured_realpath" == "$repo_realpath" ]]; then
    return 0
  fi

  echo "Codex marketplace $marketplace does not point to this checkout" >&2
  echo "configured: $configured_root" >&2
  echo "expected: $repo_root" >&2
  echo "remove the marketplace explicitly before changing its source" >&2
  return 1
}

has_claude_marketplace() {
  claude plugin marketplace list --json \
    | python3 -c '
import json
import sys

name = sys.argv[1]
items = json.load(sys.stdin)
raise SystemExit(0 if any(item.get("name") == name for item in items) else 1)
' "$marketplace"
}

claude_marketplace_metadata() {
  claude plugin marketplace list --json \
    | python3 -c '
import json
import sys

name = sys.argv[1]
items = json.load(sys.stdin)
for item in items:
    if item.get("name") == name:
        source = item.get("source", "")
        root = item.get("path", "")
        print(source + "\t" + root)
        raise SystemExit(0)
raise SystemExit(1)
' "$marketplace"
}

validate_claude_marketplace() {
  local source_type
  local configured_root
  local configured_realpath
  local repo_realpath
  IFS=$'\t' read -r source_type configured_root < <(claude_marketplace_metadata)

  if [[ "$source_type" != "directory" || -z "$configured_root" ]]; then
    echo "Claude marketplace $marketplace does not use a local directory source" >&2
    echo "remove the marketplace explicitly, then rerun the installer" >&2
    return 1
  fi

  configured_realpath="$(cd "$configured_root" 2>/dev/null && pwd -P || true)"
  repo_realpath="$(cd "$repo_root" && pwd -P)"
  if [[ "$configured_realpath" == "$repo_realpath" ]]; then
    return 0
  fi

  echo "Claude marketplace $marketplace does not point to this checkout" >&2
  echo "configured: $configured_root" >&2
  echo "expected: $repo_root" >&2
  echo "remove the marketplace explicitly before changing its source" >&2
  return 1
}

has_claude_plugin() {
  local plugin_id="${1:-$plugin@$marketplace}"
  claude plugin list --json \
    | python3 -c '
import json
import sys

plugin_id = sys.argv[1]
items = json.load(sys.stdin)
raise SystemExit(0 if any(item.get("id") == plugin_id for item in items) else 1)
' "$plugin_id"
}

claude_plugin_install_path() {
  local plugin_id="${1:-$plugin@$marketplace}"
  local expected_version
  expected_version="$(claude_manifest_version)"
  claude plugin list --json \
    | python3 -c '
import json
import sys

plugin_id = sys.argv[1]
expected_version = sys.argv[2]
items = json.load(sys.stdin)
for item in items:
    if item.get("id") == plugin_id:
        version = item.get("version", "")
        if version != expected_version:
            raise SystemExit(
                f"Claude reported installed version {version!r}, expected "
                f"{expected_version!r}"
            )
        print(item.get("installPath", ""))
        raise SystemExit(0)
raise SystemExit(1)
' "$plugin_id" "$expected_version"
}

claude_manifest_version() {
  python3 -c '
import json
import sys

with open(sys.argv[1]) as manifest:
    print(json.load(manifest)["version"])
' "$repo_root/plugins/$plugin_dir/.claude-plugin/plugin.json"
}

plugin_payloads_match() {
  local source="$1"
  local installed="$2"
  local ignored_manifest="$3"

  python3 - "$source" "$installed" "$ignored_manifest" <<'PY'
import hashlib
import os
import stat
import sys


def file_digest(path):
    digest = hashlib.sha256()
    with open(path, "rb") as stream:
        for chunk in iter(lambda: stream.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def inventory(root, ignored_manifest):
    result = {}
    pending = [(root, "")]
    while pending:
        directory, prefix = pending.pop()
        with os.scandir(directory) as entries:
            for entry in entries:
                relative = entry.name if not prefix else f"{prefix}/{entry.name}"
                mode = entry.stat(follow_symlinks=False).st_mode
                if relative == ignored_manifest and stat.S_ISREG(mode):
                    continue
                parents = relative.split("/")[:-1]
                if (
                    "__pycache__" in parents
                    and entry.name.endswith(".pyc")
                    and stat.S_ISREG(mode)
                ):
                    continue
                if stat.S_ISDIR(mode):
                    # Empty directories are not distributable payload, but walk
                    # them so every material descendant remains visible.
                    pending.append((entry.path, relative))
                elif stat.S_ISREG(mode):
                    result[relative] = (
                        "file",
                        bool(mode & stat.S_IXUSR),
                        entry.stat(follow_symlinks=False).st_size,
                        file_digest(entry.path),
                    )
                elif stat.S_ISLNK(mode):
                    result[relative] = ("symlink", os.readlink(entry.path))
                else:
                    raise OSError(f"unsupported plugin entry: {relative}")
    return result


try:
    source = inventory(sys.argv[1], sys.argv[3])
    installed = inventory(sys.argv[2], sys.argv[3])
except OSError as error:
    print(f"plugin payload verification failed: {error}", file=sys.stderr)
    raise SystemExit(2)

raise SystemExit(0 if source == installed else 1)
PY
}

verify_claude_install() {
  local source="$repo_root/plugins/$plugin_dir"
  local installed
  local payload_status=0
  installed="$(claude_plugin_install_path)"

  if [[ ! -d "$installed" ]]; then
    echo "Claude reported an invalid install path for $plugin@$marketplace" >&2
    return 1
  fi
  plugin_payloads_match \
    "$source" "$installed" ".codex-plugin/plugin.json" || payload_status=$?
  if [[ "$payload_status" -eq 1 ]]; then
    echo "Claude's cached plugin does not match the local source" >&2
    echo "bump the plugin version in both Claude manifests, then reinstall" >&2
    return 1
  fi
  if [[ "$payload_status" -ne 0 ]]; then
    echo "Claude's cached plugin could not be verified" >&2
    echo "fix payload access or remove unsupported entries, then reinstall" >&2
    return 1
  fi
}

codex_manifest_version() {
  python3 -c '
import json
import sys

with open(sys.argv[1]) as manifest:
    print(json.load(manifest)["version"])
' "$repo_root/plugins/$plugin_dir/.codex-plugin/plugin.json"
}

codex_plugin_install_path() {
  local expected_id="$plugin@$marketplace"
  local expected_version
  expected_version="$(codex_manifest_version)"

  python3 -c '
import json
import sys

expected_id = sys.argv[1]
expected_version = sys.argv[2]
result = json.load(sys.stdin)

plugin_id = result.get("pluginId")
if plugin_id != expected_id:
    raise SystemExit(
        f"Codex installed plugin {plugin_id!r}, expected {expected_id!r}"
    )

version = result.get("version")
if version != expected_version:
    raise SystemExit(
        f"Codex installed version {version}, but local source requires "
        f"{expected_version}"
    )

print(result.get("installedPath", ""))
' "$expected_id" "$expected_version"
}

verify_codex_install() {
  local source="$repo_root/plugins/$plugin_dir"
  local installed="$1"
  local payload_status=0

  if [[ ! -d "$installed" ]]; then
    echo "Codex reported an invalid install path for $plugin@$marketplace" >&2
    return 1
  fi
  plugin_payloads_match \
    "$source" "$installed" ".claude-plugin/plugin.json" || payload_status=$?
  if [[ "$payload_status" -eq 1 ]]; then
    echo "Codex's cached plugin does not match the local source" >&2
    echo "ensure the marketplace contains this checkout and uses a fresh Codex version, then reinstall" >&2
    return 1
  fi
  if [[ "$payload_status" -ne 0 ]]; then
    echo "Codex's cached plugin could not be verified" >&2
    echo "fix payload access or remove unsupported entries, then reinstall" >&2
    return 1
  fi
}

has_codex_plugin() {
  local plugin_id="${1:-$plugin@$marketplace}"
  codex plugin list --json \
    | python3 -c '
import json
import sys

plugin_id = sys.argv[1]
items = json.load(sys.stdin).get("installed", [])
raise SystemExit(0 if any(item.get("pluginId") == plugin_id for item in items) else 1)
' "$plugin_id"
}

has_claude_marketplace_name() {
  local name="$1"
  claude plugin marketplace list --json \
    | python3 -c '
import json
import sys

name = sys.argv[1]
items = json.load(sys.stdin)
raise SystemExit(0 if any(item.get("name") == name for item in items) else 1)
' "$name"
}

guard_codex_migration() {
  if has_codex_plugin "$legacy_plugin" || has_codex_marketplace_name "$legacy_marketplace"; then
    if [[ "$replace_v1" != true ]]; then
      echo "v1 is still configured as $legacy_plugin" >&2
      echo "rerun with --replace-v1 to replace it explicitly" >&2
      return 1
    fi
  fi
  return 0
}

guard_claude_migration() {
  if has_claude_plugin "$legacy_plugin" || has_claude_marketplace_name "$legacy_marketplace"; then
    if [[ "$replace_v1" != true ]]; then
      echo "v1 is still configured as $legacy_plugin" >&2
      echo "rerun with --replace-v1 to replace it explicitly" >&2
      return 1
    fi
  fi
  return 0
}

remove_codex_v1() {
  [[ "$replace_v1" == true ]] || return 0
  if has_codex_plugin "$legacy_plugin"; then
    codex plugin remove "$legacy_plugin"
  fi
  if has_codex_marketplace_name "$legacy_marketplace"; then
    codex plugin marketplace remove "$legacy_marketplace"
  fi
  return 0
}

remove_claude_v1() {
  [[ "$replace_v1" == true ]] || return 0
  if has_claude_plugin "$legacy_plugin"; then
    claude plugin uninstall -y "$legacy_plugin"
  fi
  if has_claude_marketplace_name "$legacy_marketplace"; then
    claude plugin marketplace remove "$legacy_marketplace"
  fi
  return 0
}

install_codex() {
  local install_result
  local installed

  command -v codex >/dev/null 2>&1 || {
    echo "codex is not installed" >&2
    return 1
  }

  if ! has_codex_marketplace; then
    codex plugin marketplace add "$repo_root"
  else
    refresh_codex_marketplace
  fi
  install_result="$(codex plugin add "$plugin@$marketplace" --json)"
  if ! has_codex_plugin "$plugin@$marketplace"; then
    echo "Codex did not report $plugin@$marketplace as installed" >&2
    return 1
  fi
  installed="$(printf '%s\n' "$install_result" | codex_plugin_install_path)"
  verify_codex_install "$installed"
}

install_claude() {
  command -v claude >/dev/null 2>&1 || {
    echo "claude is not installed" >&2
    return 1
  }

  if ! has_claude_marketplace; then
    claude plugin marketplace add "$repo_root"
  fi
  validate_claude_marketplace
  if has_claude_plugin "$plugin@$marketplace"; then
    claude plugin update "$plugin@$marketplace"
  else
    claude plugin install "$plugin@$marketplace"
  fi
  if ! has_claude_plugin "$plugin@$marketplace"; then
    echo "Claude did not report $plugin@$marketplace as installed" >&2
    return 1
  fi
  verify_claude_install
}

case "$target" in
  --all)
    command -v codex >/dev/null 2>&1 || {
      echo "codex is not installed" >&2
      exit 1
    }
    command -v claude >/dev/null 2>&1 || {
      echo "claude is not installed" >&2
      exit 1
    }
    guard_codex_migration
    guard_claude_migration
    install_cli
    install_codex
    install_claude
    remove_codex_v1
    remove_claude_v1
    ;;
  --codex)
    command -v codex >/dev/null 2>&1 || {
      echo "codex is not installed" >&2
      exit 1
    }
    guard_codex_migration
    install_cli
    install_codex
    remove_codex_v1
    ;;
  --claude)
    command -v claude >/dev/null 2>&1 || {
      echo "claude is not installed" >&2
      exit 1
    }
    guard_claude_migration
    install_cli
    install_claude
    remove_claude_v1
    ;;
esac

echo "Installed $plugin. Start a new Codex task or Claude session before testing."
